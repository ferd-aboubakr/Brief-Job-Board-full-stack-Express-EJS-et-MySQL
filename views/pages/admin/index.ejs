<%- include('../../partials/header', { title: 'Console Administration - MERN 2026/2027' }) %>
<%- include('../../partials/navbar', { activeNav: 'admin' }) %>

<main class="container">

  <!-- Top Header & Actions -->
  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:1.5rem;margin-bottom:1.25rem;">
    <div>
      <span style="font-size:0.7rem;font-weight:700;color:var(--teal-text);text-transform:uppercase;letter-spacing:0.05em;">
        • TÉLÉMÉTRIE PROMOTION
      </span>
      <h1 style="font-size:1.6rem;font-weight:800;margin-top:0.2rem;">Espace d'administration</h1>
      <p style="font-size:0.875rem;color:var(--text-muted);margin-top:0.2rem;">
        Gérez facilement les annonces de stage et d'alternance publiées sur la plateforme.
      </p>
    </div>

    <div style="display:flex;align-items:center;gap:0.75rem;">
      <div style="background-color:var(--border-light);border:1px solid var(--border-color);border-radius:var(--radius-md);padding:0.5rem 0.875rem;font-size:0.8125rem;text-align:right;">
        <div style="font-weight:700;color:var(--text-main);"><%= offers.length %> offres au total</div>
        <div style="font-size:0.75rem;color:var(--text-muted);"><%= counts.stage %> stages • <%= counts.alternance %> alternances</div>
      </div>
      <a href="/admin/offres/nouveau" class="btn btn-primary">
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        + Nouvelle offre
      </a>
    </div>
  </div>

  <!-- Live Alert -->
  <div style="background-color:var(--border-light);border:1px solid var(--border-color);border-radius:var(--radius-md);padding:0.75rem 1rem;font-size:0.8125rem;color:var(--text-muted);display:flex;align-items:center;gap:0.625rem;margin-bottom:1.5rem;">
    <svg style="width:18px;height:18px;color:var(--primary);flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    <div><strong>Synchronisation en direct :</strong> Toute action effectuée ici met à jour instantanément la liste publique des offres.</div>
  </div>

  <!-- Admin Offers List -->
  <div class="admin-layout" style="display:grid; grid-template-columns: 2fr 1fr; gap:1.5rem;">

    <!-- Left Column: Manageable Offers List -->
    <div>
      <% if (offers.length === 0) { %>
        <div class="card" style="text-align:center; padding:3rem 1rem;">
          <p style="color:var(--text-muted);margin-bottom:1rem;">Aucune offre enregistrée dans la base de données.</p>
          <a href="/admin/offres/nouveau" class="btn btn-primary btn-sm">+ Déposer la première offre</a>
        </div>
      <% } else { %>
        <% offers.forEach(offer => { %>
          <article class="admin-offer-card" style="margin-bottom:1rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.75rem;color:var(--text-muted);">
              <div style="display:flex;gap:0.5rem;align-items:center;">
                <span class="badge <%= offer.type_contrat === 'Stage' ? 'badge-stage' : 'badge-alternance' %>">
                  <%= offer.type_contrat %>
                </span>
                <span>📅 Publié le <%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %></span>
              </div>
              <span style="font-family:monospace;background-color:var(--border-light);padding:0.1rem 0.4rem;border-radius:var(--radius-sm);">
                ID: <%= offer.id %>
              </span>
            </div>

            <div style="margin:0.5rem 0;">
              <h3 style="font-size:1.1rem;font-weight:700;">
                <a href="/offres/<%= offer.id %>" style="color:inherit;text-decoration:none;"><%= offer.titre %></a>
              </h3>
              <div style="font-size:0.8125rem;color:var(--text-muted);margin-top:0.2rem;">
                🏢 <strong><%= offer.entreprise_nom %></strong> • 📍 <%= offer.ville %>
              </div>
            </div>

            <div>
              <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.25rem;">Technologies associées :</div>
              <div class="tech-tags-list">
                <% offer.technologies.forEach(tech => { %>
                  <span class="tech-tag"><%= tech %></span>
                <% }) %>
              </div>
            </div>

            <div class="admin-card-actions" style="margin-top:1rem;display:flex;justify-content:space-between;align-items:center;">
              <div style="display:flex;align-items:center;gap:0.375rem;color:var(--success-text);font-weight:600;font-size:0.8125rem;">
                <span class="dot dot-green"></span> En ligne
              </div>
              <div class="admin-buttons" style="display:flex;gap:0.5rem;">
                <a href="/admin/offres/<%= offer.id %>/modifier" class="btn btn-outline btn-sm">
                  <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  Modifier
                </a>

                <form action="/admin/offres/<%= offer.id %>/supprimer" method="POST" style="display:inline;" onsubmit="return confirm('Êtes-vous certain de vouloir supprimer cette offre (ID <%= offer.id %>) ?');">
                  <button type="submit" class="btn btn-danger btn-sm">
                    <svg style="width:14px;height:14px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    Supprimer
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      <% } %>
    </div>

    <!-- Right Column: Info & Stats -->
    <aside>
      <div class="card" style="position:sticky;top:80px;">
        <h2 style="font-size:1rem;font-weight:700;display:flex;align-items:center;gap:0.5rem;margin-bottom:0.75rem;">
          <svg style="width:18px;height:18px;color:var(--primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          Gestion des offres
        </h2>

        <div style="font-size:0.8125rem;color:var(--text-muted);margin-bottom:1rem;line-height:1.5;">
          Retrouvez l'ensemble des annonces validées pour la promotion et pilotez leur visibilité en temps réel.
        </div>

        <div style="background-color:var(--border-light);border-radius:var(--radius-md);padding:0.75rem;margin-bottom:1rem;font-size:0.8125rem;">
          <div style="font-weight:700;margin-bottom:0.25rem;">Actions possibles :</div>
          <ul style="padding-left:1.25rem;margin:0;color:var(--text-muted);line-height:1.6;">
            <li>Publier une nouvelle annonce</li>
            <li>Ajouter des compétences clés requises</li>
            <li>Mettre à jour les conditions du poste</li>
            <li>Retirer une annonce archivée</li>
          </ul>
        </div>

        <a href="/admin/offres/nouveau" class="btn btn-primary btn-sm" style="width:100%;justify-content:center;">
          + Créer une offre
        </a>
      </div>
    </aside>

  </div>

</main>

<%- include('../../partials/footer') %>
