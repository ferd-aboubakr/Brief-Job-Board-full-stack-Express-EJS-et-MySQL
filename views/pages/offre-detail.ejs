<%- include('../partials/header', { title: offer.titre + ' - MERN 2026/2027' }) %>
<%- include('../partials/navbar', { activeNav: 'offres' }) %>

<main class="container">

  <!-- Top Notice Bar -->
  <div class="notice-pill-bar">
    <div style="display:flex;align-items:center;gap:0.5rem;">
      <svg style="width:18px;height:18px;color:var(--teal);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      <strong>Opportunité certifiée</strong> • Profil vérifié par l'équipe pédagogique
    </div>
    <div style="display:flex;align-items:center;gap:1.5rem;">
      <span>Promotion 2026 / 2027</span>
      <span class="badge badge-teal">Candidatures ouvertes</span>
    </div>
  </div>

  <!-- Back Button & Bookmark Action -->
  <div class="detail-actions-top">
    <a href="/" class="btn btn-outline btn-sm">
      <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Retour aux offres
    </a>

    <div style="display:flex;align-items:center;gap:0.75rem;">
      <input type="checkbox" id="fav-<%= offer.id %>" class="bookmark-checkbox" data-id="<%= offer.id %>">
      <label for="fav-<%= offer.id %>" class="btn btn-outline btn-sm bookmark-btn" style="width:auto;padding:0.375rem 0.875rem;">
        <svg style="width:16px;height:16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
        Suivre cette offre
      </label>
    </div>
  </div>

  <!-- Detail Layout -->
  <div class="detail-layout">

    <!-- Left Column (Main content) -->
    <div class="detail-main">

      <!-- Job Overview Card -->
      <article class="card detail-header-card">
        <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
          <span class="badge <%= offer.type_contrat === 'Stage' ? 'badge-stage' : 'badge-alternance' %>">
            <%= offer.type_contrat %>
          </span>
          <span class="badge badge-neutral">📍 <%= offer.ville %></span>
          <span class="badge badge-neutral">📅 Publié le <%= new Date(offer.date_publication).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>

        <h1 style="font-size:1.6rem;font-weight:800;margin:0.75rem 0 0.5rem;"><%= offer.titre %></h1>

        <div class="company-meta-lg">
          <div class="company-logo-placeholder" style="width:44px;height:44px;background-color:#e0e7ff;color:var(--primary);">
            <% if (offer.entreprise_logo) { %>
              <img src="<%= offer.entreprise_logo %>" alt="<%= offer.entreprise_nom %>" style="width:100%;height:100%;object-fit:cover;border-radius:4px;">
            <% } else { %>
              🏢
            <% } %>
          </div>
          <div>
            <div style="font-weight:700;font-size:1rem;color:var(--text-main);"><%= offer.entreprise_nom %></div>
            <div style="font-size:0.8125rem;color:var(--text-muted);">
              <%= offer.entreprise_secteur || 'Secteur Numérique' %>
              <% if (offer.entreprise_site_web) { %>
                • <a href="<%= offer.entreprise_site_web %>" target="_blank" rel="noopener noreferrer" style="color:var(--primary);text-decoration:none;">Site officiel ↗</a>
              <% } %>
            </div>
          </div>
        </div>
      </article>

      <!-- Missions & Description Card -->
      <section class="card" style="margin-top:1.5rem;">
        <h2 style="font-size:1.15rem;font-weight:700;margin-bottom:0.75rem;">Description du poste & Missions</h2>
        <p style="font-size:0.925rem;line-height:1.6;color:var(--text-main);margin-bottom:1rem;">
          <%= offer.description_courte %>
        </p>
        <p style="font-size:0.925rem;line-height:1.6;color:var(--text-main);white-space:pre-line;">
          <%= offer.description_longue %>
        </p>
      </section>

      <!-- Profil Recherché Card -->
      <section class="card" style="margin-top:1.5rem;">
        <h2 style="font-size:1.15rem;font-weight:700;margin-bottom:0.75rem;">Profil recherché</h2>
        <p style="font-size:0.925rem;line-height:1.6;color:var(--text-main);white-space:pre-line;">
          <%= offer.profil_recherche %>
        </p>
      </section>

    </div>

    <!-- Right Column (Sidebar) -->
    <aside class="detail-sidebar">

      <!-- Technologies Card -->
      <div class="card" style="margin-bottom:1.5rem;">
        <h3 style="font-size:0.95rem;font-weight:700;margin-bottom:0.75rem;">Technologies requises</h3>
        <div class="tech-tags">
          <% offer.technologies.forEach(tech => { %>
            <span class="tech-tag"><%= tech %></span>
          <% }) %>
        </div>
      </div>

      <!-- Application Card -->
      <div class="card" style="margin-bottom:1.5rem;">
        <h3 style="font-size:0.95rem;font-weight:700;margin-bottom:0.75rem;">Postuler à cette offre</h3>
        <p style="font-size:0.85rem;color:var(--text-muted);margin-bottom:1rem;">
          Contactez directement l'entreprise pour transmettre votre CV et portfolio GitHub.
        </p>

        <% if (offer.lien_candidature) { %>
          <a href="<%= offer.lien_candidature %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="width:100%;text-align:center;justify-content:center;margin-bottom:0.5rem;">
            Postuler sur le site ↗
          </a>
        <% } %>

        <% if (offer.contact_email) { %>
          <a href="mailto:<%= offer.contact_email %>?subject=Candidature - <%= encodeURIComponent(offer.titre) %>" class="btn btn-outline" style="width:100%;text-align:center;justify-content:center;">
            Envoyer un email (<%= offer.contact_email %>)
          </a>
        <% } %>
      </div>

      <!-- Company Card -->
      <div class="card">
        <h3 style="font-size:0.95rem;font-weight:700;margin-bottom:0.5rem;">À propos de <%= offer.entreprise_nom %></h3>
        <p style="font-size:0.8125rem;color:var(--text-muted);line-height:1.5;">
          <%= offer.entreprise_secteur ? 'Secteur : ' + offer.entreprise_secteur : 'Entreprise partenaire YouCode' %>
        </p>
      </div>

    </aside>

  </div>

</main>

<%- include('../partials/footer') %>
